# Copy to .env.local to override. Never put secrets in VITE_ variables: they are bundled into the browser code.

# Base path the browser uses for API calls. Keep "/api" so requests go through the Vite proxy (same origin).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (the ASP.NET Core API).
VITE_API_PROXY_TARGET=http://localhost:5080
