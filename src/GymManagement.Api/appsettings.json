{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "FitForge.Api",
    "Audience": "FitForge.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AdditionalOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPerMinute": 5,
    "RegisterPer10Minutes": 3,
    "PasswordResetPer15Minutes": 3,
    "AuthenticatedPerMinute": 100,
    "AnonymousPerMinute": 60
  },
  "Gym": {
    "TimeZone": "Asia/Kolkata"
  },
  "Seed": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  }
}
